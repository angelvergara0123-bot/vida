# ══════════════════════════════════════════════════════════════
# VidaKushala — .htaccess
# Configurado para SiteGround + PWA
# ══════════════════════════════════════════════════════════════

# ── 1. ARCHIVOS CRÍTICOS DE PWA — NUNCA cachear ───────────────
<FilesMatch "(sw\.js|sw-loader\.php|manifest\.json)$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# ── 2. ASSETS ESTÁTICOS — Caché larga (1 año, immutable) ──────
# index.php añade ?v=HASH automáticamente; al cambiar el archivo
# el hash cambia y el navegador/SW obtiene la versión nueva.
<FilesMatch "\.(ico|png|jpg|jpeg|svg|webp|woff|woff2|ttf|eot)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# ── 3. CSS y JS — Siempre revalidar ──────────────────────────
# El ?v=HASH en la URL controla el caché del navegador.
# no-cache fuerza revalidación pero usa el caché si no cambió (304).
# Evita que SiteGround/NGINX sirva CSS desactualizado.
<FilesMatch "\.(css|js)$">
  Header set Cache-Control "no-cache, must-revalidate"
  Header set Pragma "no-cache"
</FilesMatch>

# ── 4. index.php y archivos PHP dinámicos — Sin caché ─────────
<FilesMatch "\.php$">
  Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  Header set Pragma "no-cache"
</FilesMatch>

# ── 5. COMPRESIÓN GZIP ────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# ── 6. HTTPS forzado ──────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
